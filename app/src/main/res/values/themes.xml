<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Base.Theme.RidaDriver" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="android:windowBackground">@color/rida_splash_background</item>
        <item name="fontFamily">@font/poppins</item>
        <item name="android:fontFamily">@font/poppins</item>
    </style>

    <style name="Theme.RidaDriver" parent="Base.Theme.RidaDriver" />

    <!-- Android displays this before the Activity or Compose has started. -->
    <style name="Theme.Rida.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/rida_splash_background</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/rida_splash_mark</item>
        <item name="postSplashScreenTheme">@style/Theme.RidaDriver</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@color/rida_splash_background</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="o_mr1">true</item>
    </style>
</resources>
